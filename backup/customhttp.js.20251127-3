#!/usr/bin/env node

// customhttp.js

const express = require('express');
const fs = require('fs');
const path = require('path');
const axios = require('axios');
const crypto = require('crypto');
const os = require('os');
const zlib = require('zlib');
const tar = require('tar');

// -------------------------
// 옵션 파싱
// -------------------------
const args = process.argv.slice(2);

const hasSend = args.includes('-s');
const hasRecv = args.includes('-r');
const fIndex  = args.indexOf('-f');
const pIndex  = args.indexOf('-p');
const hIndex  = args.indexOf('-h');

const hasB = args.includes('-b');            // progress bar
const hasNoRelease = args.includes('-norelease');
const hasC = args.includes('-c');            // Range chunk download

const hasTG = args.includes('-tg');
const hasT  = args.includes('-t');
const hasG  = args.includes('-g');

const targetPath = fIndex !== -1 ? args[fIndex + 1] : null;
const port = pIndex !== -1 ? parseInt(args[pIndex + 1], 10) : 80;
const host = hIndex !== -1 ? args[hIndex + 1] : 'localhost';

// 패킹 모드: none | tar | gz | targz
let packMode = 'none';
if (hasTG || (hasT && hasG)) {
    packMode = 'targz';
} else if (hasT) {
    packMode = 'tar';
} else if (hasG) {
    packMode = 'gz';
}

// -------------------------
// 공용 유틸
// -------------------------
function fileExists(p) {
    try {
        fs.accessSync(p, fs.constants.F_OK);
        return true;
    } catch {
        return false;
    }
}

function ensureDir(dirPath) {
    if (!fileExists(dirPath)) {
        fs.mkdirSync(dirPath, { recursive: true });
    }
}

function computeSha256(filePath) {
    return new Promise((resolve, reject) => {
        const hash = crypto.createHash('sha256');
        const rs = fs.createReadStream(filePath);
        rs.on('error', reject);
        rs.on('data', chunk => hash.update(chunk));
        rs.on('end', () => resolve(hash.digest('hex')));
    });
}

function drawProgressBar(downloaded, total) {
    if (!total || total <= 0) return;
    const ratio = downloaded / total;
    const percent = Math.floor(ratio * 100);
    const width = 40;
    const filled = Math.floor(width * ratio);
    const bar = '█'.repeat(filled) + '-'.repeat(width - filled);
    process.stdout.write(`\r[${bar}] ${percent}% (${downloaded}/${total} bytes)`);
    if (downloaded >= total) {
        process.stdout.write('\n');
    }
}

// 압축 해제 (autoRelease=true일 때만 호출)
async function autoExtractIfNeeded(filePath) {
    const dir = path.dirname(filePath);
    const base = path.basename(filePath);

    if (base.endsWith('.tar.gz') || base.endsWith('.tgz')) {
        console.log(`������ tar.gz 해제 중: ${filePath}`);
        await tar.x({
            file: filePath,
            cwd: dir,
            gzip: true
        });
        fs.unlinkSync(filePath);
        console.log(`✅ 해제 완료 (tar.gz): ${dir}`);
    } else if (base.endsWith('.tar')) {
        console.log(`������ tar 해제 중: ${filePath}`);
        await tar.x({
            file: filePath,
            cwd: dir,
            gzip: false
        });
        fs.unlinkSync(filePath);
        console.log(`✅ 해제 완료 (tar): ${dir}`);
    } else if (base.endsWith('.gz')) {
        console.log(`������ gz 해제 중: ${filePath}`);
        const destPath = filePath.replace(/\.gz$/, '');
        await new Promise((resolve, reject) => {
            const rs = fs.createReadStream(filePath);
            const ws = fs.createWriteStream(destPath);
            const gunzip = zlib.createGunzip();
            rs.pipe(gunzip).pipe(ws);
            ws.on('finish', resolve);
            ws.on('error', reject);
            rs.on('error', reject);
            gunzip.on('error', reject);
        });
        fs.unlinkSync(filePath);
        console.log(`✅ 해제 완료 (gz): ${destPath}`);
    } else {
        // 일반 파일은 그대로 둠
    }
}

// -------------------------
// 서버용: 패킹 파일 준비 (파일 또는 폴더를 단일 파일로)
// -------------------------
async function prepareSendFile(inputPath, packMode) {
    const stat = fs.statSync(inputPath);
    const isDir = stat.isDirectory();

    // 파일 & packMode=none → 원본 그대로
    if (!isDir && packMode === 'none') {
        return {
            filePath: inputPath,
            fileName: path.basename(inputPath),
            cleanup: false
        };
    }

    const baseName = path.basename(inputPath);
    const tmpDir = os.tmpdir();
    let outPath;

    if (isDir) {
        // 폴더 + tar/targz/gz => tar or tar.gz
        if (packMode === 'tar' || packMode === 'none') {
            outPath = path.join(tmpDir, `${baseName}.tar`);
            console.log(`������ 폴더 tar 생성 중: ${outPath}`);
            await tar.c(
                {
                    file: outPath,
                    cwd: path.dirname(inputPath),
                    gzip: false
                },
                [baseName]
            );
        } else if (packMode === 'targz' || packMode === 'gz') {
            outPath = path.join(tmpDir, `${baseName}.tar.gz`);
            console.log(`������ 폴더 tar.gz 생성 중: ${outPath}`);
            await tar.c(
                {
                    file: outPath,
                    cwd: path.dirname(inputPath),
                    gzip: true
                },
                [baseName]
            );
        }
    } else {
        // 단일 파일 + tar/targz/gz
        if (packMode === 'tar') {
            outPath = path.join(tmpDir, `${baseName}.tar`);
            console.log(`������ 파일 tar 생성 중: ${outPath}`);
            await tar.c(
                {
                    file: outPath,
                    cwd: path.dirname(inputPath),
                    gzip: false
                },
                [baseName]
            );
        } else if (packMode === 'targz') {
            outPath = path.join(tmpDir, `${baseName}.tar.gz`);
            console.log(`������ 파일 tar.gz 생성 중: ${outPath}`);
            await tar.c(
                {
                    file: outPath,
                    cwd: path.dirname(inputPath),
                    gzip: true
                },
                [baseName]
            );
        } else if (packMode === 'gz') {
            outPath = path.join(tmpDir, `${baseName}.gz`);
            console.log(`������ 파일 gz 생성 중: ${outPath}`);
            await new Promise((resolve, reject) => {
                const rs = fs.createReadStream(inputPath);
                const ws = fs.createWriteStream(outPath);
                const gz = zlib.createGzip();
                rs.pipe(gz).pipe(ws);
                ws.on('finish', resolve);
                ws.on('error', reject);
                rs.on('error', reject);
                gz.on('error', reject);
            });
        } else {
            // packMode === 'none'인데 isDir=false인 경우는 위에서 처리됨
            return {
                filePath: inputPath,
                fileName: baseName,
                cleanup: false
            };
        }
    }

    return {
        filePath: outPath,
        fileName: path.basename(outPath),
        cleanup: true
    };
}

// -------------------------
// 서버 모드
// -------------------------
async function startServer() {
    if (!targetPath) {
        console.error('Error: -s 모드에서는 -f <보낼 파일/폴더> 가 필요합니다.');
        process.exit(1);
    }

    const resolved = path.resolve(targetPath);

    if (!fileExists(resolved)) {
        console.error(`Error: 대상 경로가 존재하지 않습니다 → ${resolved}`);
        process.exit(1);
    }

    const stat = fs.statSync(resolved);
    const isDir = stat.isDirectory();

    let serverMode = 'single'; // 'single' | 'folder'
    let sendFilePath = null;
    let sendFileName = null;
    let sendFileSize = 0;
    let sendFileHash = null;
    let cleanup = false;

    let folderBasePath = null;        // 폴더 raw 모드일 때 base
    let folderFileList = null;        // 상대경로 리스트 캐시
    let serverPackMode = packMode;    // /meta 에서 내려줄 값

    if (isDir && packMode === 'none') {
        // 폴더 raw mode
        serverMode = 'folder';
        serverPackMode = 'none';
        folderBasePath = resolved;
        console.log(`������ 폴더 RAW 전송 모드 (tar/gz 없음): ${folderBasePath}`);
    } else {
        // 단일 파일 모드 (파일 또는 패킹된 폴더/파일)
        serverMode = 'single';
        console.log(`������ 원본 경로: ${resolved}`);
        console.log(`������ 패킹 모드: ${packMode}`);

        const prep = await prepareSendFile(resolved, packMode);
        sendFilePath = prep.filePath;
        sendFileName = prep.fileName;
        cleanup = prep.cleanup;

        const s = fs.statSync(sendFilePath);
        sendFileSize = s.size;
        sendFileHash = await computeSha256(sendFilePath);

        console.log(`������ 전송 대상 파일: ${sendFilePath}`);
        console.log(`������ 파일 크기: ${sendFileSize} bytes`);
        console.log(`������ SHA-256: ${sendFileHash}`);
    }

    const app = express();

    // /meta: 모드 & 메타 정보 제공
    app.get('/meta', (req, res) => {
        if (serverMode === 'single') {
            res.json({
                mode: 'single',
                packMode: serverPackMode,
                fileName: sendFileName,
                size: sendFileSize
            });
        } else {
            res.json({
                mode: 'folder',
                packMode: 'none',
                rootName: path.basename(folderBasePath)
            });
        }
    });

    // 폴더 raw 모드: 파일 목록
    function walkFolder(base) {
        const result = [];
        function walk(current, rel) {
            const entries = fs.readdirSync(current, { withFileTypes: true });
            for (const entry of entries) {
                const fullPath = path.join(current, entry.name);
                const relPath = rel ? path.join(rel, entry.name) : entry.name;
                if (entry.isDirectory()) {
                    walk(fullPath, relPath);
                } else if (entry.isFile()) {
                    result.push(relPath);
                }
            }
        }
        walk(base, '');
        return result;
    }

    app.get('/list', (req, res) => {
        if (serverMode !== 'folder') {
            return res.status(400).send('Not in folder mode');
        }
        if (!folderFileList) {
            folderFileList = walkFolder(folderBasePath);
            console.log(`������ 폴더 내 파일 개수: ${folderFileList.length}`);
        }
        res.json(folderFileList);
    });

    // 공통: 단일 파일 스트리밍 (Range 지원) - single mode
    function setCommonHeadersSingle(res, isPartial, start, end) {
        res.setHeader('Content-Type', 'application/octet-stream');
        res.setHeader('Content-Disposition', `attachment; filename="${sendFileName}"`);
        res.setHeader('X-File-Sha256', sendFileHash);
        if (!isPartial) {
            res.setHeader('Content-Length', sendFileSize);
        } else {
            res.setHeader('Accept-Ranges', 'bytes');
            res.setHeader('Content-Range', `bytes ${start}-${end}/${sendFileSize}`);
            res.setHeader('Content-Length', end - start + 1);
        }
    }

    // 폴더 모드에서 개별 파일 스트리밍
    async function serveFolderFile(req, res) {
        const rel = req.query.file;
        if (!rel) {
            return res.status(400).send('file query parameter is required');
        }

        // 디렉토리 탈출 방지
        const safeRel = rel.replace(/\\/g, '/');
        const fullPath = path.resolve(path.join(folderBasePath, safeRel));
        if (!fullPath.startsWith(path.resolve(folderBasePath))) {
            return res.status(400).send('Invalid path');
        }

        if (!fileExists(fullPath) || !fs.statSync(fullPath).isFile()) {
            return res.status(404).send('File not found');
        }

        const stat = fs.statSync(fullPath);
        const totalSize = stat.size;

        const range = req.headers.range;
        if (range) {
            const match = range.match(/bytes=(\d+)-(\d+)?/);
            if (!match) {
                return res.status(416).send('Invalid Range');
            }
            const start = parseInt(match[1], 10);
            let end = match[2] ? parseInt(match[2], 10) : totalSize - 1;
            if (start >= totalSize || end >= totalSize) {
                return res.status(416).send('Requested Range Not Satisfiable');
            }

            res.setHeader('Content-Type', 'application/octet-stream');
            res.setHeader('Content-Disposition', `attachment; filename="${path.basename(fullPath)}"`);
            res.setHeader('Accept-Ranges', 'bytes');
            res.setHeader('Content-Range', `bytes ${start}-${end}/${totalSize}`);
            res.setHeader('Content-Length', end - start + 1);
            res.status(206);

            const rs = fs.createReadStream(fullPath, { start, end });
            rs.on('error', err => {
                console.error('ReadStream Error:', err.message);
                res.destroy(err);
            });
            rs.pipe(res);
        } else {
            res.setHeader('Content-Type', 'application/octet-stream');
            res.setHeader('Content-Disposition', `attachment; filename="${path.basename(fullPath)}"`);
            res.setHeader('Content-Length', totalSize);
            res.status(200);
            const rs = fs.createReadStream(fullPath);
            rs.on('error', err => {
                console.error('ReadStream Error:', err.message);
                res.destroy(err);
            });
            rs.pipe(res);
        }
    }

    // /download
    app.get('/download', (req, res) => {
        if (serverMode === 'folder') {
            // 폴더 raw 모드: /download?file=상대경로
            serveFolderFile(req, res);
            return;
        }

        // 단일 파일 모드
        const range = req.headers.range;

        if (range) {
            const match = range.match(/bytes=(\d+)-(\d+)?/);
            if (!match) {
                res.status(416).send('Invalid Range');
                return;
            }
            const start = parseInt(match[1], 10);
            let end = match[2] ? parseInt(match[2], 10) : sendFileSize - 1;

            if (start >= sendFileSize || end >= sendFileSize) {
                res.status(416).send('Requested Range Not Satisfiable');
                return;
            }

            setCommonHeadersSingle(res, true, start, end);
            res.status(206);

            const rs = fs.createReadStream(sendFilePath, { start, end });
            rs.on('error', (err) => {
                console.error('ReadStream Error:', err.message);
                res.destroy(err);
            });
            rs.pipe(res);
        } else {
            setCommonHeadersSingle(res, false);
            res.status(200);
            const rs = fs.createReadStream(sendFilePath);
            rs.on('error', (err) => {
                console.error('ReadStream Error:', err.message);
                res.destroy(err);
            });
            rs.pipe(res);
        }
    });

    app.listen(port, host, () => {
        console.log('\n������ customhttp 서버 모드');
        console.log(`➡ Host: ${host}`);
        console.log(`➡ Port: ${port}`);
        console.log(`➡ Mode: ${serverMode === 'single' ? '단일 파일/아카이브' : '폴더 RAW 구조 전송'}`);
        if (serverMode === 'single') {
            console.log(`➡ PackMode: ${serverPackMode} (none/tar/gz/targz)`);
        }
        console.log(`➡ Meta URL: http://${host}:${port}/meta`);
        console.log(`➡ Download URL: http://${host}:${port}/download`);
        if (serverMode === 'folder') {
            console.log(`➡ List URL: http://${host}:${port}/list`);
        }
        console.log('');
    });
}

// -------------------------
// 클라이언트: 단일 파일 일반 다운로드
// -------------------------
async function simpleDownloadSingle(url, destPath, showBar, autoRelease) {
    const res = await axios.get(url, { responseType: 'stream' });

    const total = parseInt(res.headers['content-length'] || '0', 10);
    const serverHash = res.headers['x-file-sha256'];

    console.log(`������ 저장: ${destPath}`);
    if (total) console.log(`������ 예상 크기: ${total} bytes`);

    let downloaded = 0;
    const ws = fs.createWriteStream(destPath);

    await new Promise((resolve, reject) => {
        res.data.on('data', (chunk) => {
            downloaded += chunk.length;
            if (showBar && total) {
                drawProgressBar(downloaded, total);
            }
        });
        res.data.on('error', reject);
        ws.on('error', reject);
        ws.on('finish', resolve);
        res.data.pipe(ws);
    });

    console.log(`✅ 다운로드 완료: ${destPath}`);

    // 해시 검증
    if (serverHash) {
        const localHash = await computeSha256(destPath);
        if (localHash === serverHash) {
            console.log(`������ 해시 일치 (SHA-256): ${localHash}`);
        } else {
            console.warn(`⚠ 해시 불일치!\n  server: ${serverHash}\n  local : ${localHash}`);
        }
    }

    if (autoRelease) {
        await autoExtractIfNeeded(destPath);
    }
}

// -------------------------
// 클라이언트: 단일 파일 Range 기반 chunk 다운로드 (-c)
// -------------------------
async function rangeDownloadSingle(url, destPath, showBar, autoRelease) {
    const CHUNK_SIZE = 10 * 1024 * 1024; // 10MB

    let firstRes;
    try {
        // 첫 번째 Range 요청: 1바이트만 (bytes=0-0)
        firstRes = await axios.get(url, {
            responseType: 'arraybuffer',
            headers: { Range: 'bytes=0-0' },
            validateStatus: (s) => s === 200 || s === 206 || s === 416
        });
    } catch (err) {
        console.error('⚠ 첫 Range 요청 실패, 일반 다운로드로 폴백:', err.message);
        return simpleDownloadSingle(url, destPath, showBar, autoRelease);
    }

    // 1) 416 → Range 불가 (빈 파일 포함) → 일반 다운로드 폴백
    if (firstRes.status === 416) {
        console.log('⚠ Range 요청 불가 → 일반 다운로드로 폴백합니다.');
        return simpleDownloadSingle(url, destPath, showBar, autoRelease);
    }

    const serverHash = firstRes.headers['x-file-sha256'];

    // 2) 서버가 Range 무시하고 200으로 전체 파일 보낸 경우
    if (firstRes.status === 200) {
        console.log('ℹ 서버가 Range를 무시하고 전체 파일(200) 응답 → 일반 다운로드 경로로 처리');
        // 이미 받은 데이터를 쓰고 끝낼 수도 있지만, 코드 단순화를 위해 다시 simpleDownload 호출
        return simpleDownloadSingle(url, destPath, showBar, autoRelease);
    }

    // 여기까지 왔다면 206 Partial Content
    const cr = firstRes.headers['content-range']; // 예: bytes 0-0/12345
    if (!cr || !cr.includes('/')) {
        console.log('⚠ Content-Range 헤더가 없어 Range 모드를 사용할 수 없음 → 일반 다운로드로 폴백');
        return simpleDownloadSingle(url, destPath, showBar, autoRelease);
    }

    const total = parseInt(cr.split('/')[1], 10);
    if (!Number.isFinite(total) || total <= 0) {
        console.log('⚠ 파일 크기가 0 또는 알 수 없음 → 일반 다운로드로 폴백');
        return simpleDownloadSingle(url, destPath, showBar, autoRelease);
    }

    console.log(`������ 저장: ${destPath}`);
    console.log(`������ 예상 크기: ${total} bytes`);

    const fd = fs.openSync(destPath, 'w');
    let downloaded = 0;

    // 첫 1바이트 기록
    let buffer = Buffer.from(firstRes.data);
    fs.writeSync(fd, buffer, 0, buffer.length, 0);
    downloaded += buffer.length;
    if (showBar) {
        drawProgressBar(downloaded, total);
    }

    let position = downloaded;

    while (position < total) {
        const start = position;
        const end = Math.min(start + CHUNK_SIZE - 1, total - 1);

        const res = await axios.get(url, {
            responseType: 'arraybuffer',
            headers: { Range: `bytes=${start}-${end}` },
            validateStatus: (s) => s === 206 || s === 200
        });

        buffer = Buffer.from(res.data);
        fs.writeSync(fd, buffer, 0, buffer.length, start);
        position += buffer.length;
        downloaded += buffer.length;

        if (showBar) {
            drawProgressBar(downloaded, total);
        }
    }

    fs.closeSync(fd);
    console.log(`✅ 다운로드 완료: ${destPath}`);

    // 해시 검증
    if (serverHash) {
        const localHash = await computeSha256(destPath);
        if (localHash === serverHash) {
            console.log(`������ 해시 일치 (SHA-256): ${localHash}`);
        } else {
            console.warn(`⚠ 해시 불일치!\n  server: ${serverHash}\n  local : ${localHash}`);
        }
    }

    if (autoRelease) {
        await autoExtractIfNeeded(destPath);
    }
}

// -------------------------
// 클라이언트 모드
// -------------------------
async function startClient() {
    const saveDir = targetPath ? path.resolve(targetPath) : process.cwd();
    ensureDir(saveDir);

    const baseUrl = `http://${host}:${port}`;
    console.log(`������ 서버: ${baseUrl}`);
    console.log(`������ 저장 디렉터리: ${saveDir}`);
    console.log(`������ progress bar: ${hasB ? 'ON (-b)' : 'OFF'}`);
    console.log(`������ auto release: ${hasNoRelease ? 'OFF (-norelease)' : 'ON'}`);
    console.log(`������ chunk(range) 모드: ${hasC ? 'ON (-c)' : 'OFF'}`);

    let meta;
    try {
        const res = await axios.get(`${baseUrl}/meta`);
        meta = res.data;
    } catch (err) {
        console.error('❌ /meta 요청 실패:', err.message);
        console.error('   서버와 버전이 안 맞거나 /meta 미구현일 수 있습니다.');
        process.exit(1);
    }

    if (meta.mode === 'single') {
        // 단일 파일 모드
        const fileName = meta.fileName || 'downloaded.bin';
        const destPath = path.join(saveDir, fileName);

        const autoRelease = !hasNoRelease && meta.packMode && meta.packMode !== 'none';
        const url = `${baseUrl}/download`;

        if (hasC) {
            await rangeDownloadSingle(url, destPath, hasB, autoRelease);
        } else {
            await simpleDownloadSingle(url, destPath, hasB, autoRelease);
        }
    } else if (meta.mode === 'folder') {
        // 폴더 RAW 모드
        let listRes;
        try {
            listRes = await axios.get(`${baseUrl}/list`);
        } catch (err) {
            console.error('❌ /list 요청 실패:', err.message);
            process.exit(1);
        }

        const files = listRes.data || [];
        console.log(`������ 받을 파일 개수: ${files.length}`);

        for (const rel of files) {
            const destPath = path.join(saveDir, rel);
            ensureDir(path.dirname(destPath));

            const encoded = encodeURIComponent(rel);
            const url = `${baseUrl}/download?file=${encoded}`;

            console.log(`\n������ 파일 다운로드: ${rel}`);

            // 폴더 RAW 모드에서는 autoRelease=false (우리가 새로 생성한 tar/gz가 아니기 때문)
            const autoRelease = false;

            if (hasC) {
                await rangeDownloadSingle(url, destPath, hasB, autoRelease);
            } else {
                await simpleDownloadSingle(url, destPath, hasB, autoRelease);
            }
        }

        console.log('\n������ 폴더 RAW 다운로드 완료');
    } else {
        console.error('❌ meta.mode 값이 알 수 없습니다:', meta.mode);
        process.exit(1);
    }
}

// -------------------------
// 엔트리 포인트
// -------------------------
(async () => {
    if (hasSend) {
        await startServer();
    } else if (hasRecv) {
        await startClient();
    } else {
        console.log(`
사용법:
  서버 모드(보낼 때):
    customhttp -s -f <파일 또는 폴더 경로> [-t] [-g] [-tg] [-p 포트] [-h 호스트]

      -t      : tar로 묶기 (압축 없음)
      -g      : gzip 압축 (파일이면 .gz, 폴더면 tar.gz 역할)
      -tg     : tar.gz (tar 후 gzip)
      (없음)  : 파일은 그대로, 폴더는 tar/gz 없이 폴더 구조 그대로 RAW 전송

  클라이언트 모드(받을 때):
    customhttp -r [-f 저장폴더] [-b] [-c] [-norelease] [-p 포트] [-h 서버IP]

      -b          : 진행률(progress bar) 표시
      -c          : Range 기반 chunk 다운로드 사용
      -norelease  : -t/-g/-tg 로 보낸 tar/gz/tar.gz 자동 해제하지 않고 그대로 보존

예:
  서버:
    customhttp -s -f ./data
    customhttp -s -f ./data -t
    customhttp -s -f ./data -tg -p 8833 -h 0.0.0.0

  클라이언트:
    customhttp -r -f ./downloads
    customhttp -r -f ./downloads -b
    customhttp -r -f ./downloads -b -c
    customhttp -r -f ./downloads -b -c -norelease
`);
    }
})();

